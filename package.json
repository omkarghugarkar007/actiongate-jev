{
  "name": "actiongate-jev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open-source runtime authorization for AI-agent tool calls using deterministic policy and TypeSafe Jev directly or through OpenRouter.",
  "author": "Omkar Ghugarkar",
  "license": "Apache-2.0",
  "homepage": "https://github.com/omkarghugarkar007/actiongate-jev#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omkarghugarkar007/actiongate-jev.git"
  },
  "bugs": {
    "url": "https://github.com/omkarghugarkar007/actiongate-jev/issues"
  },
  "keywords": [
    "typesafe-ai",
    "jev",
    "openrouter",
    "ai-agents",
    "agent-security",
    "tool-calling",
    "authorization",
    "guardrails",
    "mcp",
    "typescript"
  ],
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && pnpm --filter @actiongate/web build",
    "dev": "concurrently -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "pnpm --filter @actiongate/web dev",
    "start": "tsx apps/api/src/server.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run apps/api/test/api.integration.test.ts apps/api/test/mcp.integration.test.ts apps/api/test/mcp-proxy.integration.test.ts apps/api/test/p0.integration.test.ts apps/api/test/p1.integration.test.ts apps/api/test/telemetry.integration.test.ts apps/api/test/conformance.integration.test.ts apps/api/test/simulate.integration.test.ts",
    "test:redis": "RUN_REDIS_TESTS=true vitest run apps/api/test/redis.integration.test.ts",
    "test:postgres": "RUN_POSTGRES_TESTS=true vitest run apps/api/test/postgres.integration.test.ts",
    "test:jev:live": "RUN_LIVE_JEV_TESTS=true vitest run --config vitest.live.config.ts",
    "test:typesafe:live": "RUN_LIVE_TYPESAFE_TESTS=true vitest run --config vitest.live.config.ts packages/decision-provider/test/typesafe.live.test.ts apps/api/test/typesafe.live.test.ts",
    "e2e": "playwright test",
    "jev:smoke": "tsx scripts/jev-smoke.ts",
    "typesafe:smoke": "tsx scripts/typesafe-smoke.ts",
    "cost:track": "tsx scripts/track-openrouter-cost.ts",
    "eval": "tsx packages/evals/src/cli.ts",
    "eval:generate": "tsx scripts/generate-eval-fixtures.ts",
    "refund:demo": "tsx examples/refund-agent/src/demo.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "proxy:http": "tsx scripts/run-http-proxy.ts",
    "proxy:mcp": "tsx scripts/run-mcp-proxy.ts",
    "manifests:validate": "tsx scripts/validate-connector-manifests.ts",
    "api:generate": "tsx scripts/generate-openapi.ts",
    "client:generate": "tsx scripts/generate-client.ts",
    "build:packages": "tsx scripts/build-packages.ts",
    "packages:check": "tsx scripts/check-package-exports.ts",
    "eval:dataset": "tsx scripts/build-eval-dataset.ts",
    "eval:calibrate": "tsx packages/evals/src/cli.ts calibrate",
    "eval:drift": "tsx packages/evals/src/cli.ts drift",
    "drill:dependency": "tsx scripts/dependency-drill.ts",
    "sbom": "tsx scripts/generate-sbom.ts",
    "test:python": "python3 -m pytest packages/sdk-python/tests -q",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "examples:guarded": "tsx examples/guarded-tools/src/demo.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "examples:embedded": "tsx examples/guarded-tools/src/embedded-demo.ts",
    "conformance:record": "tsx scripts/record-conformance.ts",
    "examples:embedded:python": "python3 examples/guarded-tools/embedded_demo.py",
    "mcp:guard": "tsx scripts/mcp-guard.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.3",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.11.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "postcss": "^8.5.23"
    }
  }
}
