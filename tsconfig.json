{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": {
      "@actiongate/core": ["packages/core/src/index.ts"],
      "@actiongate/decision-provider": ["packages/decision-provider/src/index.ts"],
      "@actiongate/sdk": ["packages/sdk-js/src/index.ts"],
      "@actiongate/mcp-gateway": ["packages/mcp-gateway/src/index.ts"],
      "@actiongate/mcp-proxy": ["packages/mcp-proxy/src/index.ts"],
      "@actiongate/proxy-core": ["packages/proxy-core/src/index.ts"],
      "@actiongate/http-proxy": ["packages/http-proxy/src/index.ts"],
      "@actiongate/connector-manifest": ["packages/connector-manifest/src/index.ts"],
      "@actiongate/conformance": ["packages/conformance/src/index.ts"],
      "@actiongate/adapters": ["packages/adapters/src/index.ts"],
      "@actiongate/db": ["packages/db/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "examples/**/*.ts", "scripts/**/*.ts", "infra/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "dist", "apps/web"]
}
