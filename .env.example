# Copy to .env. Never commit real credentials.
NODE_ENV=development
PORT=8080
WEB_PORT=3000
API_URL=http://localhost:8080
DATABASE_URL=postgres://actiongate:actiongate@localhost:5432/actiongate
REDIS_URL=redis://localhost:6379
POSTGRES_PORT=5432
REDIS_PORT=6379

# Server-side only. OPENROUTER_KEY is accepted as a deprecated local alias.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_MS=2000
DECISION_PROVIDER=fake

ACTIONGATE_API_KEY=ag_test_local
ACTIONGATE_DEV_TENANT_ID=tenant-1
ACTIONGATE_STORAGE=memory
ACTIONGATE_CONTROL_PLANE=memory
ACTIONGATE_REDIS_PREFIX=actiongate
ACTIONGATE_IDEMPOTENCY_LEASE_MS=15000
ACTIONGATE_IDEMPOTENCY_WAIT_MS=10000
ACTIONGATE_GRANT_SECRET=development-only-actiongate-grant-secret
ACTIONGATE_GRANT_TTL_SECONDS=30
ACTIONGATE_FAIL_OPEN_READ_ONLY=false

# Production uses JSON key rings so a new active key can overlap with old verification keys.
# Generate independent secrets with: openssl rand -base64 32
# ACTIONGATE_GRANT_KEYS={"grant_2026_09":"replace-with-an-independent-32-byte-secret"}
# ACTIONGATE_GRANT_ACTIVE_KID=grant_2026_09
# ACTIONGATE_EVIDENCE_KEYS={"evidence_2026_09":"replace-with-an-independent-32-byte-secret"}
# ACTIONGATE_EVIDENCE_ACTIVE_KID=evidence_2026_09

# Seed settings for the PostgreSQL control plane.
ACTIONGATE_SEED_TENANT=tenant-1
ACTIONGATE_SEED_TENANT_NAME=Local development tenant
ACTIONGATE_SEED_ENVIRONMENT=development

# Optional subsystems. Each stays off unless its secret is present.
# ACTIONGATE_CREDENTIAL_SECRET=   # enables POST /v1/grants/exchange
# ACTIONGATE_CREDENTIAL_KID=cred_1
# ACTIONGATE_WEBHOOK_URL=         # requires ACTIONGATE_WEBHOOK_SECRET
# ACTIONGATE_WEBHOOK_SECRET=
# ACTIONGATE_OTLP_ENDPOINT=       # pushes the same metrics /metrics serves
# ACTIONGATE_TENANT_QUOTAS={"acme":{"authorizePerMinute":60,"providerCostUsdPerDay":5}}
